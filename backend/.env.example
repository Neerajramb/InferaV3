# Copy to .env and adjust. The defaults below suit local development.

# --- Django -------------------------------------------------------------------
# DJANGO_DEBUG defaults to False. With it off, DJANGO_SECRET_KEY is required.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CSRF_TRUSTED_ORIGINS=https://infera.example.com

# Production behind HTTPS (only read when DJANGO_DEBUG is off)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# USE_X_FORWARDED_PROTO=True

# --- Answers ------------------------------------------------------------------
# auto (Ollama, falling back to quoting passages), ollama, extractive, or gemini.
# gemini sends retrieved passages to Google, so it is never chosen automatically.
LLM_PROVIDER=auto
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=mistral
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- Retrieval ----------------------------------------------------------------
# auto (sentence-transformers if available) or hash (offline bag of words).
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=6

# --- Limits -------------------------------------------------------------------
MAX_UPLOAD_MB=25
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
LOGIN_THROTTLE_RATE=10/min
