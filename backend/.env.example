# Copy to .env and adjust. Every value here is optional for local development.

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Lets a signed-in user preview other roles. Defaults to DJANGO_DEBUG. Keep off in production.
ALLOW_ROLE_SWITCH=True

# Answers: auto (Ollama, falling back to quoting passages), ollama, extractive, or gemini.
# gemini sends retrieved passages to Google, so it is never chosen automatically.
LLM_PROVIDER=auto
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=mistral
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Embeddings: auto (sentence-transformers if available) or hash (offline bag of words).
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

MAX_UPLOAD_MB=25
RAG_TOP_K=6
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
