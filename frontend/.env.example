# Copy to .env.local to override. Both values are optional.

# Where the Django API lives. Defaults to http://127.0.0.1:8000/api
# VITE_API_URL=https://infera.example.com/api

# Show one-click demo sign-in on the login page of a production build
# (it is always shown in development). Only for public demo deployments.
# VITE_DEMO_ACCOUNTS=true
